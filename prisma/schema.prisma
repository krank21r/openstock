generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model WatchlistItem {
  id        String   @id @default(cuid())
  symbol    String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SignalState {
  symbol    String   @id
  verdict   String? // last observed verdict — used to detect transitions
  updatedAt DateTime @updatedAt
}

model SignalAlert {
  id           String   @id @default(cuid())
  symbol       String
  companyName  String?
  direction    String // "Long" | "Short" — derived from the verdict
  verdict      String // verdict snapshot (Buy / Strong Buy / Sell / Strong Sell)
  score        Float
  confidence   Int
  priceAtAlert Float?
  alertKey     String // "YYYY-MM-DD:Long" — one alert per symbol per day per direction
  status       String   @default("OPEN") // OPEN | STALE | TAKEN | DISMISSED
  tradeId      String? // set when the user takes the trade
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([symbol, alertKey])
  @@index([status])
  @@index([createdAt])
}

model TrackedTrade {
  id           String    @id @default(cuid())
  symbol       String
  companyName  String?
  direction    String // "Long" | "Short"
  entryPrice   Float
  stopLoss     Float
  target1      Float
  target2      Float
  riskReward   Float?
  riskLevel    String?
  confidence   Int?
  verdict      String? // signal verdict snapshot at entry
  status       String    @default("OPEN") // OPEN | TP1_HIT | TP2_HIT | SL_HIT
  hitTp1       Boolean   @default(false)
  highWater    Float? // highest price seen since entry
  lowWater     Float? // lowest price seen since entry
  lastPrice    Float?
  pnlPct       Float?
  progressPct  Float? // 0-100+ progress from entry toward target2
  closedReason String?
  openedAt     DateTime  @default(now())
  hitTp1At     DateTime?
  closedAt     DateTime?

  @@index([status])
  @@index([openedAt])
}
